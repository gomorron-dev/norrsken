<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Norrsken.Shell</AssemblyName>
    <RootNamespace>Norrsken.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\norrsken.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <Product>Norrsken</Product>
    <Company>Norrsken Project</Company>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>


