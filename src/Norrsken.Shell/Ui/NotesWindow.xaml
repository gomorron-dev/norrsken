<Window x:Class="Norrsken.Shell.Ui.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Norrsken.Shell.Ui"
        Title="Notes" Width="820" Height="620" MinWidth="420" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{DynamicResource SurfaceSolid}" FontFamily="{StaticResource UiFont}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="{DynamicResource R0}" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="Root" Background="{DynamicResource SurfaceSolid}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
          TextElement.Foreground="{DynamicResource Text}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
      </Grid.RowDefinitions>

      <!-- Title bar: file actions left, name centred, window pebbles right -->
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource IconButton}" Width="34" Height="30" ToolTip="New window (Ctrl+N)" Click="New_Click">
            <Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="34" Height="30" ToolTip="Open (Ctrl+O)" Click="Open_Click">
            <Path Data="M3,7.5 C3,6.4 3.9,5.5 5,5.5 L9.2,5.5 L11,7.5 L19,7.5 C20.1,7.5 21,8.4 21,9.5 L21,17.5 C21,18.6 20.1,19.5 19,19.5 L5,19.5 C3.9,19.5 3,18.6 3,17.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="34" Height="30" ToolTip="Save (Ctrl+S)" Click="Save_Click">
            <Path Data="M12,4 V15 M7.5,10.5 L12,15 L16.5,10.5 M5,19.5 H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
          </Button>
          <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Width="34" Height="30" ToolTip="More" Click="More_Click">
            <Path Data="M6,12 H6.1 M12,12 H12.1 M18,12 H18.1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="4" Stretch="Uniform"/>
          </Button>
        </StackPanel>
        <TextBlock x:Name="TitleText" FontSize="12.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
        <ui:WindowPebbles HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>

      <!-- Find / replace bar -->
      <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Margin="12,0,12,8" Padding="10,6" CornerRadius="{DynamicResource R12}"
              Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock x:Name="MatchText" FontSize="12" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button Style="{StaticResource IconButton}" Width="30" Height="28" ToolTip="Previous (Shift+F3)" Click="FindPrev_Click">
                <Path Data="M6,15 L12,9 L18,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="8" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource IconButton}" Width="30" Height="28" ToolTip="Next (F3)" Click="FindNext_Click">
                <Path Data="M6,9 L12,15 L18,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="8" Stretch="Uniform"/>
              </Button>
              <ToggleButton x:Name="CaseToggle" Style="{StaticResource AppChip}" Content="Aa" ToolTip="Match case" Margin="4,0,0,0" Padding="8,3"/>
              <Button Style="{StaticResource IconButton}" Width="30" Height="28" ToolTip="Close (Esc)" Click="CloseFind_Click">
                <Path Data="M7,7 L17,17 M17,7 L7,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
              </Button>
            </StackPanel>
            <TextBox x:Name="FindBox" Style="{StaticResource PlainTextBox}" FontSize="13.5" Height="28" TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
          </DockPanel>
          <DockPanel x:Name="ReplaceRow" Visibility="Collapsed" Margin="0,4,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource LinkButton}" Content="Replace" Margin="8,0" Click="Replace_Click"/>
              <Button Style="{StaticResource LinkButton}" Content="Replace all" Click="ReplaceAll_Click"/>
            </StackPanel>
            <TextBox x:Name="ReplaceBox" Style="{StaticResource PlainTextBox}" FontSize="13.5" Height="28"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBox x:Name="Editor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" BorderThickness="0" Padding="22,6,22,6"
               Background="Transparent" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" SelectionBrush="{DynamicResource TextDim}"
               FontFamily="Cascadia Mono, Consolas" FontSize="14.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               UndoLimit="1000" SpellCheck.IsEnabled="False" TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged"/>

      <!-- Status bar -->
      <DockPanel Grid.Row="3" Margin="22,0" TextElement.FontSize="11.5" TextElement.Foreground="{DynamicResource TextDim}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ZoomText" Margin="16,0,0,0"/>
          <TextBlock x:Name="EolText" Margin="16,0,0,0"/>
          <TextBlock x:Name="EncodingText" Margin="16,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PosText"/>
          <TextBlock x:Name="CountText" Margin="16,0,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- Unsaved-changes prompt -->
      <Grid x:Name="Prompt" Grid.RowSpan="4" Visibility="Collapsed" Background="#66000000">
        <Border x:Name="PromptCard" Width="380" CornerRadius="{DynamicResource R16}" Padding="22" Background="{DynamicResource SurfaceSolid}"
                BorderBrush="{DynamicResource DockLine}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock x:Name="PromptTitle" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Your changes will be lost if you don't save them." Style="{StaticResource Note}" Margin="0,6,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource LinkButton}" Content="Cancel" Margin="0,0,14,0" Click="PromptCancel_Click"/>
              <Button Style="{StaticResource LinkButton}" Content="Don't save" Margin="0,0,14,0" Click="PromptDiscard_Click"/>
              <Button Style="{StaticResource PrimaryButton}" Content="Save" Padding="20,7" Click="PromptSave_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
