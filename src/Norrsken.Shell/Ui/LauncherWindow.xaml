<Window x:Class="Norrsken.Shell.Ui.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Norrsken Launcher" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Width="860" Height="680"
        FontFamily="{StaticResource UiFont}">
  <Window.Resources>
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
              <Grid.RenderTransform><ScaleTransform x:Name="Sc"/></Grid.RenderTransform>
              <Border x:Name="Bd" CornerRadius="14" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
              <Border x:Name="HoverLayer" CornerRadius="14" Background="{DynamicResource Hover}" Opacity="0"/>
              <Border x:Name="Fill" CornerRadius="14" Background="{DynamicResource Text}" Opacity="0"/>
              <Border Padding="14,5"><ContentPresenter TextElement.FontSize="12.5"/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SurfaceSolid}"/>
                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.08"/><DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.08"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="AppTile">
      <Border x:Name="Bd" Width="98" Height="96" Margin="2" CornerRadius="14" Background="Transparent" Cursor="Hand"
              MouseLeftButtonUp="AppTile_Click" AutomationProperties.Name="{Binding Name}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Click="Open_Click"/>
            <MenuItem Header="Pin to Start / unpin" Click="TogglePinStart_Click"/>
            <MenuItem Header="Keep in dock / remove" Click="TogglePin_Click"/>
          </ContextMenu>
        </Border.ContextMenu>
        <StackPanel VerticalAlignment="Center">
          <ContentControl Width="42" Height="42" Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" Focusable="False"/>
          <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="6,8,6,0" TextAlignment="Center"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Card" Margin="30" RenderTransformOrigin="0.5,0.35">
    <Grid.RenderTransform>
      <TransformGroup><ScaleTransform x:Name="CardScale"/><TranslateTransform x:Name="CardShift"/></TransformGroup>
    </Grid.RenderTransform>

    <Border CornerRadius="22" Background="{DynamicResource SurfaceSolid}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
      </Border.Effect>
    </Border>

    <Border x:Name="Root" CornerRadius="22" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource DockLine}"
            BorderThickness="1" TextElement.Foreground="{DynamicResource Text}" TextElement.FontFamily="{StaticResource UiFont}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search -->
        <Border Margin="20,18,20,0" Height="46" CornerRadius="23" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
          <Grid Margin="18,0">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Margin="30,0,40,0" Style="{StaticResource PlainTextBox}" FontFamily="{StaticResource DisplayFont}" FontSize="17"
                     AutomationProperties.Name="Search apps, files and settings" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            <TextBlock x:Name="Placeholder" Text="Search apps, files and settings" Margin="32,0,0,0" FontFamily="{StaticResource DisplayFont}"
                       FontSize="17" IsHitTestVisible="False" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextDim}"/>
          </Grid>
        </Border>

        <!-- Filter chips (search mode) -->
        <StackPanel x:Name="Chips" Grid.Row="1" Orientation="Horizontal" Margin="22,12,22,0" Visibility="Collapsed">
          <RadioButton Style="{StaticResource Chip}" GroupName="filter" Tag="all" Content="All" IsChecked="True" Checked="Chip_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="filter" Tag="apps" Content="Apps" Checked="Chip_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="filter" Tag="files" Content="Files and folders" Checked="Chip_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="filter" Tag="settings" Content="Settings" Checked="Chip_Checked"/>
        </StackPanel>

        <!-- Home: Pinned + All apps -->
        <ScrollViewer x:Name="HomeView" Grid.Row="3" Margin="12,8,6,0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="0,0,6,10">
            <DockPanel Margin="12,6,12,4">
              <TextBlock Text="Pinned" FontSize="13" FontWeight="SemiBold"/>
            </DockPanel>
            <ItemsControl x:Name="PinnedGrid" ItemTemplate="{StaticResource AppTile}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <DockPanel Margin="12,16,12,6">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <RadioButton x:Name="FoldersView" Style="{StaticResource Chip}" GroupName="allview" Content="Folders" IsChecked="True" Checked="AllView_Checked"/>
                <RadioButton x:Name="AzView" Style="{StaticResource Chip}" GroupName="allview" Content="A–Z" Checked="AllView_Checked" Margin="0"/>
              </StackPanel>
              <TextBlock Text="All apps" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <WrapPanel x:Name="FolderGrid"/>
            <ItemsControl x:Name="AllGrid" ItemTemplate="{StaticResource AppTile}" Focusable="False" Visibility="Collapsed">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- An open folder -->
        <Grid x:Name="FolderView" Grid.Row="3" Margin="12,8,6,0" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="6,4,12,8">
            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Click="FolderBack_Click" ToolTip="Back (Esc)">
              <Path Data="M15,6 L9,12 L15,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="13" Stretch="Uniform"/>
            </Button>
            <TextBlock x:Name="FolderTitle" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="FolderApps" ItemTemplate="{StaticResource AppTile}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- Search results + preview -->
        <Grid x:Name="SearchView" Grid.Row="3" Margin="12,10,18,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
          </Grid.ColumnDefinitions>
          <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="ResultsPanel" Margin="0,0,10,10"/>
          </ScrollViewer>
          <Border x:Name="PreviewCard" Grid.Column="1" CornerRadius="16" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,10">
            <StackPanel x:Name="PreviewPanel" Margin="20"/>
          </Border>
          <TextBlock x:Name="EmptyText" Grid.ColumnSpan="2" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Visibility="Collapsed"/>
        </Grid>

        <!-- Profile and power -->
        <Border Grid.Row="4" Margin="14,4,14,14" CornerRadius="16" Background="{DynamicResource SurfaceAlt}" Padding="10,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Sleep" Click="Sleep_Click"><TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="14"/></Button>
              <Button Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Lock" Click="Lock_Click"><TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14"/></Button>
              <Button Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Sign out" Click="SignOut_Click"><TextBlock Text="&#xF3B1;" FontFamily="{StaticResource IconFont}" FontSize="14"/></Button>
              <Button Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Restart" Click="Restart_Click"><TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="14"/></Button>
              <Button x:Name="PowerButton" Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Shut down" Click="ShutDown_Click"><Button.ContextMenu><ContextMenu x:Name="PowerMenu"/></Button.ContextMenu><TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="14"/></Button>
              <Border Width="1" Margin="6,8" Background="{DynamicResource Border}"/>
              <Button Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"><TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"/></Button>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="Account_Click" ToolTip="Your account">
              <StackPanel Orientation="Horizontal" Margin="4,3,12,3">
                <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True" Background="{DynamicResource Pressed}">
                  <Grid>
                    <TextBlock x:Name="Initial" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                    <Ellipse x:Name="Avatar" Width="30" Height="30"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="UserName" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0" Foreground="{DynamicResource Text}"/>
              </StackPanel>
            </Button>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
