<Window x:Class="Norrsken.Shell.Ui.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Norrsken.Shell.Ui"
        xmlns:core="clr-namespace:Norrsken.Shell.Core"
        Title="Welcome to Norrsken" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="{DynamicResource SurfaceSolid}" FontFamily="{StaticResource UiFont}">
  <Grid x:Name="Root" TextElement.Foreground="{DynamicResource Text}" TextElement.FontFamily="{StaticResource UiFont}">
    <Grid MaxWidth="900" Margin="56,48">

      <!-- 1 · Hello -->
      <StackPanel x:Name="HelloStep" VerticalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="{DynamicResource R18}" Background="{DynamicResource Text}" HorizontalAlignment="Left">
          <Viewbox Margin="14">
            <Canvas Width="24" Height="24">
              <Path Data="M3,14 C6,4 10,4 12,9.5 C14,15 18,15 21,5" Stroke="{DynamicResource SurfaceSolid}"
                    StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M5,20 L19,20" Stroke="{DynamicResource SurfaceSolid}" StrokeThickness="2.2" Opacity="0.55"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Viewbox>
        </Border>
        <TextBlock Text="Welcome to Norrsken" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="SemiBold" Margin="0,30,0,0"/>
        <TextBlock FontSize="17" Foreground="{DynamicResource TextDim}" Margin="2,10,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                   Text="A calm, monochrome desktop. Every program, game and shortcut you know from Windows works here."/>
        <TextBlock Text="Choose a look" Style="{StaticResource PageTitle}" Margin="2,40,0,12"/>
        <WrapPanel x:Name="ThemeList"/>
        <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Content="Continue" HorizontalAlignment="Left" Margin="0,34,0,0" Click="Hello_Continue"/>
      </StackPanel>

      <!-- 2 · Bring your files back (only when an old Windows is found) -->
      <Grid x:Name="RestoreStep" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="RestoreTitle" Text="Bring your files back" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold"/>
          <TextBlock x:Name="RestoreSubtitle" FontSize="15" Foreground="{DynamicResource TextDim}" Margin="1,8,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                     Text="Your previous Windows is still on this PC. Copy your files into your new desktop — nothing is moved or overwritten, and every file is checked afterwards. Windows removes the old copy by itself after about ten days."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="0,0,12,0">
            <StackPanel x:Name="RestoreChoices">
              <TextBlock x:Name="ProfileHeader" Text="Whose files" Style="{StaticResource PageTitle}" Margin="2,10,0,10"/>
              <WrapPanel x:Name="ProfileList"/>
              <TextBlock Text="What to bring" Style="{StaticResource PageTitle}" Margin="2,22,0,10"/>
              <WrapPanel x:Name="FolderList"/>
            </StackPanel>
            <ItemsControl x:Name="RestoreList" ItemTemplate="{StaticResource TaskRow}" Focusable="False" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,18,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="RestoreSkipButton" Style="{StaticResource LinkButton}" FontSize="13.5" Content="Not now" VerticalAlignment="Center" Click="RestoreSkip_Click"/>
            <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="Bring them back" Margin="14,0,0,0" Click="Restore_Click"/>
            <Button x:Name="RestoreNextButton" Style="{StaticResource PrimaryButton}" Content="Continue" Margin="14,0,0,0" Visibility="Collapsed" Click="RestoreSkip_Click"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 3 · Pick apps -->
      <Grid x:Name="AppsStep" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Pick your apps" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold"/>
          <TextBlock x:Name="AppsSubtitle" FontSize="15" Foreground="{DynamicResource TextDim}" Margin="1,8,0,0" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                     Text="They install in the background. Game essentials — Visual C++, DirectX and .NET runtimes — are always included, so .exe programs and games just work."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel x:Name="CategoryList" Margin="0,0,12,0"/>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,18,0,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="SelectedText" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="Installing accepts each app's licence terms." FontSize="12" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Style="{StaticResource LinkButton}" FontSize="13.5" Content="Skip for now" VerticalAlignment="Center" Click="Skip_Click"/>
            <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install" Margin="14,0,0,0" Click="Install_Click"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 4 · Installing -->
      <Grid x:Name="InstallStep" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="InstallTitle" Text="Setting things up" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold"/>
          <TextBlock x:Name="InstallSubtitle" FontSize="15" Foreground="{DynamicResource TextDim}" Margin="1,8,0,0" TextWrapping="Wrap"
                     Text="You can start using Norrsken now — installs keep going in the background."/>
        </StackPanel>
        <Grid Grid.Row="1" Height="4" Margin="0,24,0,0">
          <Border CornerRadius="{DynamicResource R2}" Background="{DynamicResource Pressed}"/>
          <Border x:Name="ProgressFill" CornerRadius="{DynamicResource R2}" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0"/>
        </Grid>
        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl x:Name="InstallList" ItemTemplate="{StaticResource TaskRow}" Margin="0,0,12,0" Focusable="False"/>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,18,0,0">
          <Button x:Name="RetryButton" Style="{StaticResource LinkButton}" FontSize="13.5" Content="Retry the ones that failed"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="Retry_Click"/>
          <Button x:Name="FinishButton" Style="{StaticResource PrimaryButton}" Content="Go to my desktop" HorizontalAlignment="Right" Click="Finish_Click"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
