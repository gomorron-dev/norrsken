<Window x:Class="Norrsken.Shell.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Norrsken.Shell.Ui"
        Title="Settings" Width="1000" Height="740" MinWidth="640" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceSolid}" FontFamily="{StaticResource UiFont}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,1" Cursor="Hand" Background="Transparent">
              <Border x:Name="Sel" CornerRadius="9" Background="{DynamicResource Selection}" Opacity="0"/>
              <Border x:Name="HoverLayer" CornerRadius="9" Background="{DynamicResource Hover}" Opacity="0"/>
              <Border Padding="10,7"><ContentPresenter/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
              <Trigger Property="IsSelected" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="{DynamicResource SurfaceSolid}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
          TextElement.Foreground="{DynamicResource Text}" TextElement.FontFamily="{StaticResource UiFont}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="22,16,0,10"/>
          <Border DockPanel.Dock="Top" CornerRadius="10" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Height="34" Margin="12,0,12,10">
            <Grid Margin="10,0">
              <TextBlock x:Name="FindHint" Text="Find a setting" FontSize="13" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="FindBox" Style="{StaticResource PlainTextBox}" FontSize="13" TextChanged="FindBox_TextChanged"/>
            </Grid>
          </Border>
          <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Margin="10,0,10,12" ItemContainerStyle="{StaticResource NavItem}"
                   SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock x:Name="PageTitleText" FontSize="12.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <ui:WindowPebbles HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
          <ScrollViewer.RenderTransform><TranslateTransform x:Name="BodyShift"/></ScrollViewer.RenderTransform>
          <Grid x:Name="PageHost" Margin="44,0,44,44" MaxWidth="660">
            <!-- Personalisation & dock (Norrsken's own settings); the other pages are built in SettingsPages.cs -->
            <StackPanel x:Name="NorrskenPage">
              <TextBlock Text="Personalisation" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="4,4,0,0"/>
              <TextBlock x:Name="VersionText" Style="{StaticResource Note}" Margin="4,2,0,0"/>

              <TextBlock Text="Theme" Style="{StaticResource PageTitle}"/>
              <WrapPanel x:Name="ThemeList"/>

              <TextBlock Text="Wallpaper" Style="{StaticResource PageTitle}"/>
              <WrapPanel x:Name="WallpaperList"/>
              <Border Style="{StaticResource Group}" Margin="0,8,0,0">
                <StackPanel>
                  <CheckBox x:Name="MatchWallpaperToggle" Style="{StaticResource Toggle}" Content="Wallpaper and lock screen follow the theme"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="FramesToggle" Style="{StaticResource Toggle}" Content="Window title bars follow the theme"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="TitleBarsToggle" Style="{StaticResource Toggle}" Content="Norrsken title bars on every app (centred title, pebble buttons)"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="CursorsToggle" Style="{StaticResource Toggle}" Content="Norrsken pointers"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </StackPanel>
              </Border>

              <TextBlock Text="Dock" Style="{StaticResource PageTitle}"/>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <CheckBox x:Name="MagnifyToggle" Style="{StaticResource Toggle}" Content="Magnify icons on hover"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="PreviewsToggle" Style="{StaticResource Toggle}" Content="Live window previews"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="ReserveToggle" Style="{StaticResource Toggle}" Content="Keep windows clear of the dock"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="AutoHideToggle" Style="{StaticResource Toggle}" Content="Hide the dock when not in use"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="ClockToggle" Style="{StaticResource Toggle}" Content="Show clock"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="BinToggle" Style="{StaticResource Toggle}" Content="Show the Bin (drop files on it to delete them)"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="Clock24Toggle" Style="{StaticResource Toggle}" Content="24-hour time"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="SecondsToggle" Style="{StaticResource Toggle}" Content="Show seconds"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="HideTaskbarToggle" Style="{StaticResource Toggle}" Content="Hide the Windows taskbar"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </StackPanel>
              </Border>
              <TextBlock Style="{StaticResource Note}"
                         Text="The Windows taskbar comes back automatically when Norrsken quits — even if it crashes."/>

              <TextBlock Text="Norrsken apps" Style="{StaticResource PageTitle}"/>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <CheckBox x:Name="ReplaceToggle" Style="{StaticResource Toggle}" Content="Use Norrsken's Files, Notes, Screenshot and Settings"
                            Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                  <Border Style="{StaticResource Hairline}"/>
                  <CheckBox x:Name="AutostartToggle" Style="{StaticResource Toggle}" Content="Start Norrsken when you sign in"
                            Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                </StackPanel>
              </Border>
              <TextBlock Style="{StaticResource Note}"
                         Text="PrtScn and Win+Shift+S take a screenshot, Win+E opens Files and Win+I opens Settings. Every other Windows shortcut works as usual."/>

              <TextBlock Text="Motion" Style="{StaticResource PageTitle}"/>
              <Border Style="{StaticResource Group}">
                <CheckBox x:Name="ReduceMotionToggle" Style="{StaticResource Toggle}" Content="Reduce motion"
                          Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
              </Border>

              <TextBlock Text="Keyboard" Style="{StaticResource PageTitle}"/>
              <Border Style="{StaticResource Group}">
                <StackPanel x:Name="KeyList"/>
              </Border>
              <TextBlock x:Name="PathsText" Style="{StaticResource Note}" Margin="4,16,0,0"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
