<Window x:Class="Norrsken.Shell.Ui.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Norrsken.Shell.Core"
        xmlns:ui="clr-namespace:Norrsken.Shell.Ui"
        Title="Norrsken Dock" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Width="1920" Height="150"
        FontFamily="{StaticResource UiFont}">
  <Window.Resources>
    <ui:BoolToDouble x:Key="DotWidth" True="16" False="4"/>
    <DataTemplate x:Key="DockItemTemplate" DataType="{x:Type core:DockItem}">
      <!-- Children[0] = Lift (icon, transforms: magnify, appear, bounce), Children[1] = running dot -->
      <Grid x:Name="Cell" Width="54" Height="56" Background="Transparent" Cursor="Hand"
            AutomationProperties.Name="{Binding Name}"
            MouseDown="Item_MouseDown" MouseMove="Item_MouseMove" MouseUp="Item_MouseUp" Loaded="Cell_Loaded">
        <Grid Width="42" Height="42" VerticalAlignment="Top" Margin="0,5,0,0" RenderTransformOrigin="0.5,1">
          <Grid.RenderTransform>
            <TransformGroup><ScaleTransform/><ScaleTransform/><TranslateTransform/></TransformGroup>
          </Grid.RenderTransform>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" Focusable="False"/>
        </Grid>
        <Border Width="{Binding IsActive, Converter={StaticResource DotWidth}}" Height="4" CornerRadius="2"
                Opacity="{Binding DotOpacity}" Background="{DynamicResource Dot}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3"/>
        <!-- A soft light pools under an icon as it magnifies (opacity driven by the dock's frame loop). -->
        <Ellipse Width="50" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,-2" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="-1">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#55A0A0A0" Offset="0"/>
              <GradientStop Color="#00A0A0A0" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Canvas x:Name="Overlay" IsHitTestVisible="False" Panel.ZIndex="5">
      <Border x:Name="HoverLabel" Opacity="0" CornerRadius="8" Padding="10,4,10,5"
              Background="{DynamicResource SurfaceSolid}" BorderBrush="{DynamicResource DockLine}" BorderThickness="1">
        <TextBlock x:Name="HoverText" FontSize="12" Foreground="{DynamicResource Text}"/>
      </Border>
    </Canvas>

    <!-- Auto-hide: a nearly invisible strip at the screen edge (alpha 1/255 keeps it hit-testable). -->
    <Border x:Name="RevealZone" Height="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="600"
            Background="#01808080" Visibility="Collapsed" MouseEnter="RevealZone_MouseEnter" ToolTip="Show the dock">
      <!-- A quiet handle: the dock is down here. -->
      <Border Width="132" Height="5" CornerRadius="2.5" VerticalAlignment="Bottom" Margin="0,0,0,4" Background="{DynamicResource Text}" Opacity="0.28" IsHitTestVisible="False"/>
    </Border>

    <Grid x:Name="DockHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
          MouseMove="Dock_MouseMove" MouseLeave="Dock_MouseLeave">
      <Grid.RenderTransform><TranslateTransform x:Name="DockShift"/></Grid.RenderTransform>

      <Border x:Name="Pill" CornerRadius="21" Background="{DynamicResource DockBg}"
              BorderBrush="{DynamicResource DockLine}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270"
                            Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
        </Border.Effect>
      </Border>
      <!-- Glass rim: a faint highlight along the top edge and a soft sheen that fades downward. -->
      <Border x:Name="Rim" CornerRadius="21" BorderThickness="1" IsHitTestVisible="False">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0CFFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <StackPanel x:Name="Strip" Orientation="Horizontal" Margin="6,2">
        <Grid x:Name="LauncherCell" Width="54" Height="56" Background="Transparent" Cursor="Hand"
              AutomationProperties.Name="Open launcher"
              MouseDown="Launcher_MouseDown" MouseUp="Launcher_MouseUp">
          <Grid x:Name="LauncherLift" Width="42" Height="42" VerticalAlignment="Top" Margin="0,5,0,0" RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
              <TransformGroup><ScaleTransform/><ScaleTransform/><TranslateTransform/></TransformGroup>
            </Grid.RenderTransform>
            <Border CornerRadius="11" Background="{DynamicResource Text}">
              <Viewbox Margin="9">
                <!-- Norrsken mark: an aurora ribbon over a horizon -->
                <Canvas Width="24" Height="24">
                  <Path Data="M3,14 C6,4 10,4 12,9.5 C14,15 18,15 21,5" Stroke="{DynamicResource SurfaceSolid}"
                        StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Path Data="M5,20 L19,20" Stroke="{DynamicResource SurfaceSolid}" StrokeThickness="2.2" Opacity="0.55"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
            </Border>
          </Grid>
        </Grid>

        <Border x:Name="Div1" Width="1" Height="30" Margin="7,0" VerticalAlignment="Center" Background="{DynamicResource DockLine}"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.3"/><GradientStop Color="#FF000000" Offset="0.7"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.OpacityMask></Border>

        <ItemsControl x:Name="DockItems" ItemTemplate="{StaticResource DockItemTemplate}" VerticalAlignment="Center" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Now playing: shown while any app plays media (Spotify, YouTube in a browser, Flickerbox…) -->
        <Border x:Name="Div3" Width="1" Height="30" Margin="7,0" VerticalAlignment="Center" Background="{DynamicResource DockLine}" Visibility="Collapsed"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.3"/><GradientStop Color="#FF000000" Offset="0.7"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.OpacityMask></Border>
        <Grid x:Name="MediaCell" Height="56" Visibility="Collapsed" Background="Transparent" AutomationProperties.Name="Now playing">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
            <Border x:Name="MediaArt" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Pressed}" Cursor="Hand" ClipToBounds="True"
                    MouseLeftButtonUp="MediaInfo_Click" ToolTip="Open the app that's playing">
              <Grid>
                <ui:GlyphIcon x:Name="MediaArtGlyph" Glyph="music" Width="16" Height="16" Foreground="{DynamicResource TextDim}"/>
                <!-- A tiny equaliser dances in the corner while something plays. -->
                <Border x:Name="MediaEq" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" CornerRadius="4" Padding="3,2" Background="#99000000">
                  <StackPanel Orientation="Horizontal" Height="9" VerticalAlignment="Bottom">
                    <Border x:Name="Eq1" Width="2" Height="4" Margin="0,0,1.5,0" CornerRadius="1" Background="White" VerticalAlignment="Bottom"/>
                    <Border x:Name="Eq2" Width="2" Height="8" Margin="0,0,1.5,0" CornerRadius="1" Background="White" VerticalAlignment="Bottom"/>
                    <Border x:Name="Eq3" Width="2" Height="6" CornerRadius="1" Background="White" VerticalAlignment="Bottom"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <StackPanel x:Name="MediaInfo" Width="150" Margin="10,0,4,0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="MediaInfo_Click">
              <TextBlock x:Name="MediaTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}"/>
              <TextBlock x:Name="MediaArtist" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDim}" Margin="0,1,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Width="28" Height="30" ToolTip="Previous" AutomationProperties.Name="Previous track" Click="MediaPrev_Click">
              <ui:GlyphIcon Glyph="prev" Filled="True" Width="11" Height="11"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Play or pause" AutomationProperties.Name="Play or pause" Click="MediaPlay_Click" Foreground="{DynamicResource Text}">
              <ui:GlyphIcon x:Name="MediaPlayGlyph" Glyph="pause" Width="13" Height="13"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="28" Height="30" ToolTip="Next" AutomationProperties.Name="Next track" Click="MediaNext_Click">
              <ui:GlyphIcon Glyph="next" Filled="True" Width="11" Height="11"/>
            </Button>
          </StackPanel>
        </Grid>

        <Border x:Name="Div2" Width="1" Height="30" Margin="7,0" VerticalAlignment="Center" Background="{DynamicResource DockLine}"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.3"/><GradientStop Color="#FF000000" Offset="0.7"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.OpacityMask></Border>

        <Grid x:Name="ClockCell" MinWidth="58" Height="56" Background="Transparent" Cursor="Hand"
              AutomationProperties.Name="Quick settings" MouseUp="Clock_MouseUp">
          <Border CornerRadius="12" Margin="0,7">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=ClockCell}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <Ellipse x:Name="NotifyDot" Width="6" Height="6" Fill="{DynamicResource Text}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,6,0" Visibility="Collapsed" IsHitTestVisible="False"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,10,0">
            <ui:GlyphIcon x:Name="NetGlyph" Glyph="ethernet" Width="15" Height="15" Foreground="{DynamicResource TextDim}"
                          VerticalAlignment="Center"/>
            <ui:GlyphIcon x:Name="VolGlyph" Glyph="volume" Width="15" Height="15" Foreground="{DynamicResource TextDim}"
                          VerticalAlignment="Center" Margin="6,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="TimeText" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="FocusText" FontSize="10.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" Visibility="Collapsed" ToolTip="Focus session"/>
              <TextBlock x:Name="BatteryText" FontSize="10.5" Foreground="{DynamicResource TextDim}"
                         HorizontalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
