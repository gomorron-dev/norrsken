<Window x:Class="Norrsken.Shell.Ui.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:ui="clr-namespace:Norrsken.Shell.Ui"
        Title="Files" Width="1180" Height="740" MinWidth="600" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceSolid}" FontFamily="{StaticResource UiFont}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <sys:Double x:Key="FileIconSize">64</sys:Double>
    <sys:Double x:Key="FileTileWidth">104</sys:Double>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,1" Cursor="Hand" Background="Transparent">
              <Border x:Name="Sel" CornerRadius="9" Background="{DynamicResource Selection}" Opacity="0"/>
              <Border x:Name="HoverLayer" CornerRadius="9" Background="{DynamicResource Hover}" Opacity="0"/>
              <Border Padding="10,7"><ContentPresenter/></Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
              <Trigger Property="IsSelected" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FileItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="2" Background="Transparent">
              <Border x:Name="Sel" CornerRadius="10" Background="{DynamicResource Selection}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Opacity="0"/>
              <Border x:Name="HoverLayer" CornerRadius="10" Background="{DynamicResource Hover}" Opacity="0"/>
              <ContentPresenter/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
              <Trigger Property="IsSelected" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabPill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="9" Padding="12,5,6,5" Margin="0,0,4,0" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" MaxWidth="220">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="GridTemplate">
      <StackPanel Width="{DynamicResource FileTileWidth}" Margin="0,8,0,8" Opacity="{Binding Opacity}" ToolTip="{Binding Tip}">
        <Image Source="{Binding Icon}" Width="{DynamicResource FileIconSize}" Height="{DynamicResource FileIconSize}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{Binding Name}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   MaxHeight="34" Margin="6,6,6,0" Foreground="{DynamicResource Text}"/>
        <TextBlock Text="{Binding Detail}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,1,6,0" Foreground="{DynamicResource TextDim}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers><DataTrigger Binding="{Binding Detail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ListTemplate">
      <Grid Height="34" Opacity="{Binding Opacity}" ToolTip="{Binding Tip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="110"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
          <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
        <TextBlock Grid.Column="2" Text="{Binding TypeName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDim}"/>
        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource TextDim}"/>
      </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="GridPanel"><WrapPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="ListPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
  </Window.Resources>

  <Border x:Name="Root" Background="{DynamicResource SurfaceSolid}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
          TextElement.Foreground="{DynamicResource Text}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Files" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="22,17,0,12"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="10,0,10,12">
              <TextBlock x:Name="PinnedHeader" Text="Pinned" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" Margin="12,0,0,4"/>
              <ListBox x:Name="PinList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                       SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10"/>
              <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                       SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <TextBlock Text="Drives" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" Margin="12,14,0,4"/>
              <ListBox x:Name="DriveList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                       SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Margin="8,0,0,0">
          <ui:WindowPebbles DockPanel.Dock="Right" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Back (Alt+Left)" Click="Back_Click">
              <Path Data="M15,6 L9,12 L15,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="13" Stretch="Uniform"/>
            </Button>
            <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Forward (Alt+Right)" Click="Forward_Click">
              <Path Data="M9,6 L15,12 L9,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="13" Stretch="Uniform"/>
            </Button>
            <Button x:Name="UpButton" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Up (Alt+Up)" Click="Up_Click">
              <Path Data="M12,19 V5 M6,11 L12,5 L18,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="14" Stretch="Uniform"/>
            </Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border CornerRadius="10" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Width="200" Height="32" Margin="0,0,6,0">
              <Grid Margin="10,0">
                <TextBlock x:Name="SearchHint" Text="Search  ·  Enter for subfolders" FontSize="12.5" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="SearchBox" Style="{StaticResource PlainTextBox}" FontSize="13" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
              </Grid>
            </Border>
            <Button x:Name="NewFolderButton" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="New folder (Ctrl+Shift+N)" Click="NewFolder_Click">
              <Path Data="M3,7.5 C3,6.4 3.9,5.5 5,5.5 L9.2,5.5 L11,7.5 L19,7.5 C20.1,7.5 21,8.4 21,9.5 L21,17.5 C21,18.6 20.1,19.5 19,19.5 L5,19.5 C3.9,19.5 3,18.6 3,17.5 Z M12,10.5 V16.5 M9,13.5 H15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="14" Stretch="Uniform"/>
            </Button>
            <Button x:Name="ViewButton" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Switch view (Ctrl+Shift+1/2)" Click="View_Click">
              <Path x:Name="ViewGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
            </Button>
            <Button x:Name="PreviewButton" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Preview pane (Alt+P)" Click="PreviewToggle_Click">
              <Path Data="M3.5,5 H20.5 V19 H3.5 Z M14.5,5 V19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="14" Stretch="Uniform"/>
            </Button>
            <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="More" Click="Menu_Click">
              <Path Data="M6,12 H6.1 M12,12 H12.1 M18,12 H18.1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="4" Stretch="Uniform"/>
            </Button>
          </StackPanel>
          <!-- Breadcrumb; click empty space (or Ctrl+L) to type a path -->
          <Border x:Name="PathBox" Margin="6,10" CornerRadius="10" Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True"
                  MouseLeftButtonDown="PathBox_MouseDown" Cursor="IBeam">
            <Grid>
              <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
              </ScrollViewer>
              <TextBox x:Name="PathEdit" Style="{StaticResource PlainTextBox}" FontSize="13" Margin="10,0" Visibility="Collapsed"
                       KeyDown="PathEdit_KeyDown" LostKeyboardFocus="PathEdit_LostFocus"/>
            </Grid>
          </Border>
        </DockPanel>

        <!-- Tabs (shown once there's more than one) -->
        <DockPanel x:Name="TabBar" Grid.Row="1" Margin="12,0,12,6" Visibility="Collapsed">
          <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" Margin="0,0,6,0">
            <Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
          </Button>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
          </ScrollViewer>
        </DockPanel>

        <!-- Column headers (details view) -->
        <Grid x:Name="Headers" Grid.Row="2" Height="28" Margin="14,0,22,0" Visibility="Collapsed" TextElement.FontSize="11.5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="110"/>
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource LinkButton}" Tag="Name" Click="Sort_Click" HorizontalAlignment="Left" Margin="34,0,0,0"><TextBlock x:Name="SortName" Text="Name"/></Button>
          <Button Grid.Column="1" Style="{StaticResource LinkButton}" Tag="Modified" Click="Sort_Click" HorizontalAlignment="Left" Margin="-6,0,0,0"><TextBlock x:Name="SortModified" Text="Date modified"/></Button>
          <Button Grid.Column="2" Style="{StaticResource LinkButton}" Tag="Type" Click="Sort_Click" HorizontalAlignment="Left" Margin="-6,0,0,0"><TextBlock x:Name="SortType" Text="Type"/></Button>
          <Button Grid.Column="3" Style="{StaticResource LinkButton}" Tag="Size" Click="Sort_Click" HorizontalAlignment="Right" Margin="0,0,6,0"><TextBlock x:Name="SortSize" Text="Size"/></Button>
        </Grid>

        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
          </Grid.ColumnDefinitions>

          <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Padding="10,4,10,10"
                   SelectionMode="Extended" ItemContainerStyle="{StaticResource FileItem}" AllowDrop="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                   MouseDoubleClick="Items_DoubleClick" SelectionChanged="Items_SelectionChanged" KeyDown="Items_KeyDown" TextInput="Items_TextInput"
                   ContextMenuOpening="Items_ContextMenuOpening" PreviewMouseLeftButtonDown="Items_PreviewMouseDown" PreviewMouseMove="Items_PreviewMouseMove"
                   PreviewMouseWheel="Items_PreviewMouseWheel" MouseUp="Items_MouseUp" Drop="Items_Drop" DragOver="Items_DragOver">
            <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
          </ListBox>

          <TextBlock x:Name="EmptyText" Text="This folder is empty" FontSize="13" Foreground="{DynamicResource TextDim}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>

          <!-- Preview pane -->
          <Border x:Name="PreviewPane" Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <StackPanel x:Name="PreviewContent" Margin="20,12,20,20"/>
            </ScrollViewer>
          </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="22,0" TextElement.FontSize="11.5" TextElement.Foreground="{DynamicResource TextDim}">
          <TextBlock x:Name="MessageText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Name prompt (rename, new folder, new file) -->
        <Grid x:Name="NamePrompt" Grid.RowSpan="5" Visibility="Collapsed" Background="#66000000">
          <Border x:Name="NameCard" Width="400" CornerRadius="16" Padding="22" Background="{DynamicResource SurfaceSolid}"
                  BorderBrush="{DynamicResource DockLine}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock x:Name="NameTitle" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
              <Border CornerRadius="10" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Height="36" Margin="0,14,0,0" Padding="10,0">
                <TextBox x:Name="NameBox" Style="{StaticResource PlainTextBox}" FontSize="14" KeyDown="NameBox_KeyDown"/>
              </Border>
              <TextBlock x:Name="NameError" Style="{StaticResource Note}" Margin="2,8,0,0"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource LinkButton}" Content="Cancel" Margin="0,0,14,0" Click="NameCancel_Click"/>
                <Button x:Name="NameOk" Style="{StaticResource PrimaryButton}" Content="OK" Padding="20,7" Click="NameOk_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Quick Look (Space) -->
      <Grid x:Name="QuickLook" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#B3000000" MouseLeftButtonDown="QuickLook_MouseDown">
        <Border x:Name="QuickCard" CornerRadius="18" Background="{DynamicResource SurfaceSolid}" BorderBrush="{DynamicResource DockLine}" BorderThickness="1"
                Margin="60" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform x:Name="QuickScale"/></Border.RenderTransform>
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
              <TextBlock x:Name="QuickInfo" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="16,0,0,0"/>
              <TextBlock x:Name="QuickName" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid x:Name="QuickBody"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
